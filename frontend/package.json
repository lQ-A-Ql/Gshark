{
  "name": "@meow-traffic/sentinel-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:wails": "vite build && powershell -ExecutionPolicy Bypass -File ../scripts/build-backend-binary.ps1 && powershell -ExecutionPolicy Bypass -File ../scripts/check-desktop-assets.ps1",
    "boundary:check": "node scripts/check-boundaries.mjs",
    "ci": "pnpm run package-manager:check && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run size:check && pnpm run boundary:check && pnpm run client:any:check && pnpm run mapper:any:check && pnpm run wire:any:check && pnpm run wails-binding:check && pnpm run desktop-transport-policy:check && pnpm run desktop-generic-ipc:check && pnpm run desktop-generic-ipc-retirement:check && pnpm run desktop-generic-ipc-rollback:check && pnpm run desktop-generic-ipc-removal-preflight:check && pnpm run desktop-generic-ipc-binding-cleanup-preflight:check && pnpm run desktop-generic-ipc-post-removal:check && pnpm run desktop-old-binding:check && pnpm run desktop-misc-compat:check && pnpm run test:run && pnpm run build",
    "client:any:check": "node scripts/check-client-any.mjs",
    "desktop-generic-ipc:check": "node scripts/check-desktop-generic-ipc-allowlist.mjs",
    "desktop-generic-ipc-binding-cleanup-preflight:check": "node scripts/check-desktop-generic-ipc-binding-cleanup-preflight.mjs",
    "desktop-generic-ipc-post-removal:check": "node scripts/check-desktop-generic-ipc-post-removal-monitor.mjs",
    "desktop-generic-ipc-removal-preflight:check": "node scripts/check-desktop-generic-ipc-removal-preflight.mjs",
    "desktop-generic-ipc-retirement:check": "node scripts/check-desktop-generic-ipc-retirement-readiness.mjs",
    "desktop-generic-ipc-rollback:check": "node scripts/check-desktop-generic-ipc-rollback-guard.mjs",
    "desktop-misc-compat:check": "node scripts/check-desktop-misc-compat-inventory.mjs",
    "desktop-old-binding:check": "node scripts/check-desktop-old-binding-compat.mjs",
    "desktop-transport-policy:check": "node scripts/check-desktop-transport-policy.mjs",
    "format:check": "node scripts/check-format.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"eslint.config.js\" --max-warnings=0",
    "mapper:any:check": "node scripts/check-mapper-any.mjs",
    "package-manager:check": "node scripts/check-package-manager.mjs",
    "preview": "vite preview",
    "size:check": "node scripts/check-size.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "wails-binding:check": "node scripts/check-wails-bindings.mjs",
    "wire:any:check": "node scripts/check-wire-any.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.2.7",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-progress": "1.1.2",
    "@radix-ui/react-scroll-area": "1.2.3",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-separator": "1.1.2",
    "@radix-ui/react-slot": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.487.0",
    "pako": "^2.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "2.1.7",
    "react-router": "7.13.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "24.3.0",
    "@types/pako": "^2.0.4",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fast-check": "^3.23.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.7.4",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.46.4",
    "vite": "6.3.5",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}
